{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "checks": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "evidence": {
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "status": {
            "enum": [
              "passed",
              "failed",
              "not_available"
            ],
            "type": "string"
          }
        },
        "required": [
          "id",
          "status",
          "evidence"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "findings": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "evidence": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "rule_id": {
            "type": "string"
          },
          "severity": {
            "enum": [
              "critical",
              "high",
              "medium",
              "low"
            ],
            "type": "string"
          }
        },
        "required": [
          "severity",
          "rule_id",
          "message",
          "evidence"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "reviewer": {
      "const": "codex",
      "type": "string"
    },
    "summary": {
      "type": "string"
    },
    "verdict": {
      "enum": [
        "approve",
        "requires_changes",
        "reject"
      ],
      "type": "string"
    }
  },
  "required": [
    "reviewer",
    "verdict",
    "summary",
    "findings",
    "checks"
  ],
  "type": "object"
}
