@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix eow: <https://knowledge.example.com/ontology/core#> .
@prefix ex: <https://knowledge.example.com/ontology/fixture#> .
@prefix module: <https://knowledge.example.com/id/module/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

ex:MissingDate a owl:Class ;
    skos:prefLabel "Fecha ausente"@es ;
    skos:definition "Clase de prueba sin fecha de creación ni modificación."@es ;
    dcterms:isPartOf module:fixture ;
    eow:status "active" ;
    dcterms:source "fixture P03 missing date" ;
    dcterms:creator "generator" .
