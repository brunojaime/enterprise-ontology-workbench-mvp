@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:MissingLabel a owl:Class ;
    skos:definition "Clase de prueba sin etiqueta preferida."@es ;
    dcterms:isPartOf module:fixture ;
    eow:status "active" ;
    dcterms:source "fixture P03 missing label" ;
    dcterms:creator "generator" ;
    dcterms:created "2026-08-12"^^xsd:date .
