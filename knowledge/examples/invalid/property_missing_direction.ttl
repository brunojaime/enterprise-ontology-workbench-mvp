# Contraejemplo dirigido: solo falta skos:scopeNote con la dirección de lectura.
ex:propertyMissingDirection a owl:ObjectProperty ;
    rdfs:domain valid:ExampleClass ;
    rdfs:range valid:ExampleClass ;
    skos:prefLabel "propiedad sin dirección"@es ;
    skos:definition "Propiedad sintética que omite intencionalmente su dirección de lectura."@es ;
    skos:example "ex:example_a ex:propertyMissingDirection ex:example_b ." ;
    dcterms:isPartOf module:fixture ;
    eow:status "active" ;
    dcterms:source "Contraejemplo de propiedad sin dirección de Plan 02"@es ;
