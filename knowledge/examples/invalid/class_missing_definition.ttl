@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix eow: <https://knowledge.example.com/ontology/core#> .
@prefix ex: <https://knowledge.example.com/example/invalid/> .
@prefix module: <https://knowledge.example.com/id/module/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# Contraejemplo dirigido: solo falta skos:definition.
ex:ClassMissingDefinition a owl:Class ;
    skos:prefLabel "Clase sin definición"@es ;
    dcterms:isPartOf module:fixture ;
    eow:status "active" ;
    dcterms:source "Contraejemplo de clase sin definición de Plan 02"@es ;
    dcterms:creator "Codex generator" ;
    dcterms:created "2026-08-12"^^xsd:date .
