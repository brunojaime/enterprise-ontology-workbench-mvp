# Contraejemplo dirigido: el estado no pertenece al vocabulario permitido.
ex:ConceptInvalidStatus a skos:Concept ;
    skos:prefLabel "Concepto con estado inválido"@es ;
    skos:definition "Concepto sintético completo salvo por un estado fuera del vocabulario controlado."@es ;
    dcterms:isPartOf module:fixture ;
