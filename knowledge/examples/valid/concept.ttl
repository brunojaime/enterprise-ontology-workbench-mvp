@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix eow: <https://knowledge.example.com/ontology/core#> .
@prefix ex: <https://knowledge.example.com/example/valid/> .
@prefix module: <https://knowledge.example.com/id/module/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:ExampleConcept a skos:Concept ;
    skos:prefLabel "Concepto de ejemplo"@es ;
    skos:definition "Concepto sintético completo usado para probar vocabularios controlados."@es ;
    dcterms:isPartOf module:fixture ;
    eow:status "active" ;
    dcterms:source "Fixture válido de concepto de Plan 02"@es ;
    dcterms:creator "Codex generator" ;
    dcterms:created "2026-08-12"^^xsd:date .
