@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix eow: <https://knowledge.example.com/ontology/core#> .
@prefix ex: <https://knowledge.example.com/example/valid/> .
@prefix module: <https://knowledge.example.com/id/module/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:ExampleClass a owl:Class ;
    skos:prefLabel "Clase de ejemplo"@es ;
    skos:definition "Clase sintética completa usada para probar el contrato mínimo de metadata."@es ;
    dcterms:isPartOf module:fixture ;
    eow:status "active" ;
    dcterms:source "Fixture válido de clase de Plan 02"@es ;
    dcterms:creator "Codex generator" ;
    dcterms:created "2026-08-12"^^xsd:date .
