@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix eow: <https://knowledge.example.com/ontology/core#> .
@prefix module: <https://knowledge.example.com/id/module/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix software: <https://knowledge.example.com/ontology/software#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

software:SourceCodeRepository a owl:Class ;
    dcterms:created "2026-08-14"^^xsd:date ;
    dcterms:creator "Codex" ;
    dcterms:isPartOf module:software ;
    dcterms:source "Git del checkout y README.md"@es ;
    skos:definition "Repositorio versionado que contiene los artefactos fuente mediante los cuales se implementa software."@es ;
    skos:prefLabel "Repositorio de código fuente"@es ;
    eow:status "proposed" .

