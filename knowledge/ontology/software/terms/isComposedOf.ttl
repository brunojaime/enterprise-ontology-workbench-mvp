@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix eow: <https://knowledge.example.com/ontology/core#> .
@prefix module: <https://knowledge.example.com/id/module/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix software: <https://knowledge.example.com/ontology/software#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

software:isComposedOf a owl:ObjectProperty ;
    dcterms:created "2026-08-14"^^xsd:date ;
    dcterms:creator "Codex" ;
    dcterms:isPartOf module:software ;
    dcterms:source "enterprise_ontology_workbench_mvp_spec.md, secciones 4 y 8"@es ;
    rdfs:domain software:Application ;
    rdfs:range software:SoftwareComponent ;
    skos:definition "Vincula una aplicación con un componente de software que forma parte de ella."@es ;
    skos:example "app:workbench software:isComposedOf component:ontology_core ."@es ;
    skos:prefLabel "se compone de"@es ;
    skos:scopeNote "Se lee desde la aplicación hacia uno de sus componentes de software."@es ;
    eow:status "proposed" .

