@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix eow: <https://knowledge.example.com/ontology/core#> .
@prefix module: <https://knowledge.example.com/id/module/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix software: <https://knowledge.example.com/ontology/software#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

software:implementedByRepository a owl:ObjectProperty ;
    dcterms:created "2026-08-14"^^xsd:date ;
    dcterms:creator "Codex" ;
    dcterms:isPartOf module:software ;
    dcterms:source "packages/ontology_core/ y Git del checkout"@es ;
    rdfs:domain software:SoftwareComponent ;
    rdfs:range software:SourceCodeRepository ;
    skos:definition "Indica el repositorio de código fuente que contiene la implementación de un componente de software."@es ;
    skos:example "component:ontology_core software:implementedByRepository repository:enterprise_ontology_workbench_mvp ."@es ;
    skos:prefLabel "es implementado por repositorio"@es ;
    skos:scopeNote "Se lee desde el componente hacia el repositorio que contiene su implementación."@es ;
    eow:status "proposed" .

