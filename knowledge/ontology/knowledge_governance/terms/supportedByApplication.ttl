@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix eow: <https://knowledge.example.com/ontology/core#> .
@prefix kg: <https://knowledge.example.com/ontology/knowledge_governance#> .
@prefix module: <https://knowledge.example.com/id/module/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix software: <https://knowledge.example.com/ontology/software#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

kg:supportedByApplication a owl:ObjectProperty ;
    dcterms:created "2026-08-14"^^xsd:date ;
    dcterms:creator "Codex" ;
    dcterms:isPartOf module:knowledge_governance ;
    dcterms:source "enterprise_ontology_workbench_mvp_spec.md, secciones 4 y 8"@es ;
    rdfs:domain kg:KnowledgePublicationProcess ;
    rdfs:range software:Application ;
    skos:definition "Indica la aplicación que ofrece soporte operativo a un proceso de publicación de conocimiento."@es ;
    skos:example "kgid:ontology_change_publication kg:supportedByApplication app:workbench ."@es ;
    skos:prefLabel "es soportado por aplicación"@es ;
    skos:scopeNote "Se lee desde el proceso gobernado hacia la aplicación que lo soporta."@es ;
    eow:status "proposed" .

