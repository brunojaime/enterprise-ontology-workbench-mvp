@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix eow: <https://knowledge.example.com/ontology/core#> .
@prefix kg: <https://knowledge.example.com/ontology/knowledge_governance#> .
@prefix module: <https://knowledge.example.com/id/module/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

kg:governedThrough a owl:ObjectProperty ;
    dcterms:created "2026-08-14"^^xsd:date ;
    dcterms:creator "Codex" ;
    dcterms:isPartOf module:knowledge_governance ;
    dcterms:source "enterprise_ontology_workbench_mvp_spec.md, sección 4"@es ;
    rdfs:domain skos:Concept ;
    rdfs:range kg:KnowledgePublicationProcess ;
    skos:definition "Vincula un concepto de gobierno con el proceso concreto mediante el cual se aplica."@es ;
    skos:example "kg:EnterpriseKnowledgeGovernance kg:governedThrough kgid:ontology_change_publication ."@es ;
    skos:prefLabel "se gobierna mediante"@es ;
    skos:scopeNote "Se lee desde el concepto de gobernanza hacia un proceso de publicación de conocimiento."@es ;
    eow:status "proposed" .

