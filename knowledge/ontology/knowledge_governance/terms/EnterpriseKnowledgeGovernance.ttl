<urn:eow:proposal-statement:20fa573ab7831fced012c7a9b81c094d78798045684c21e33aac46c74b669eb1> a rdf:Statement ;
    dcterms:source "Recorrido transversal definido en la pregunta real del piloto P12"@es ;
