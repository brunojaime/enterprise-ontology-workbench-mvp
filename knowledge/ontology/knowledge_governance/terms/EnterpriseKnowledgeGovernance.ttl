kg:EnterpriseKnowledgeGovernance a skos:Concept ;
    dcterms:created "2026-08-14"^^xsd:date ;
    dcterms:creator "Codex" ;
    dcterms:isPartOf module:knowledge_governance ;
    dcterms:source "enterprise_ontology_workbench_mvp_spec.md, secciones 1 a 4 y 34"@es ;
    skos:definition "Disciplina que controla cómo el conocimiento empresarial se propone, valida, revisa y publica como información canónica trazable."@es ;
    skos:prefLabel "Gobernanza del conocimiento empresarial"@es ;
    eow:status "proposed" ;
    kg:governedThrough kgid:ontology_change_publication .

