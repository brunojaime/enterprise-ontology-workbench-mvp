@prefix cqv: <https://knowledge.example.com/ontology/competency#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix eow: <https://knowledge.example.com/ontology/core#> .
@prefix module: <https://knowledge.example.com/id/module/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

cqv:expectedBoolean a owl:DatatypeProperty ;
    rdfs:domain cqv:CompetencyQuestion ; rdfs:range xsd:boolean ;
    skos:prefLabel "booleano esperado"@es ;
    skos:definition "Resultado booleano esperado al ejecutar una pregunta ASK."@es ;
    skos:scopeNote "Se lee desde la pregunta hacia el booleano que determina su aceptación."@es ;
    skos:example "cq:applications_exist cqv:expectedBoolean true ." ;
    dcterms:isPartOf module:competency ; eow:status "active" ;
    dcterms:source "Especificación canónica, Plan 04"@es ;
    dcterms:creator "Codex generator" ; dcterms:created "2026-08-12"^^xsd:date .
