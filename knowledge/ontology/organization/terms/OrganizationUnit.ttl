@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix eow: <https://knowledge.example.com/ontology/core#> .
@prefix module: <https://knowledge.example.com/id/module/> .
@prefix org: <https://knowledge.example.com/ontology/organization#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

org:OrganizationUnit a owl:Class ;
    skos:prefLabel "Unidad organizativa"@es ;
    skos:definition "Agrupación organizativa identificable usada únicamente para ejercitar relaciones entre módulos fixture."@es ;
    dcterms:isPartOf module:organization ;
    eow:status "active" ;
    dcterms:source "Fixture sintético de organización de Plan 02"@es ;
    dcterms:creator "Codex generator" ;
    dcterms:created "2026-08-12"^^xsd:date .
