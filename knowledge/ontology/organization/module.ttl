@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix eow: <https://knowledge.example.com/ontology/core#> .
@prefix module: <https://knowledge.example.com/id/module/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://knowledge.example.com/ontology/organization> a owl:Ontology ;
    owl:imports <https://knowledge.example.com/ontology/core> ;
    dcterms:identifier "organization" ;
    dcterms:isPartOf module:organization ;
    dcterms:rightsHolder "Equipo de arquitectura empresarial"@es ;
    dcterms:creator "Codex generator" ;
    dcterms:created "2026-08-12"^^xsd:date ;
    dcterms:source "Especificación canónica, Plan 02"@es ;
    eow:status "active" ;
    skos:prefLabel "Módulo fixture de organización"@es ;
    skos:definition "Fixture mínimo para probar modularidad; no constituye una ontología empresarial definitiva."@es .
