@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix eow: <https://knowledge.example.com/ontology/core#> .
@prefix module: <https://knowledge.example.com/id/module/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

eow:OntologyModule a owl:Class ;
    skos:prefLabel "Módulo de ontología"@es ;
    skos:definition "Unidad modular con ownership, imports, ruta de archivos y grafo responsable explícitos."@es ;
    dcterms:isPartOf module:core ;
    eow:status "active" ;
    dcterms:source "Especificación canónica, secciones 11 a 16"@es ;
    dcterms:creator "Codex generator" ;
    dcterms:created "2026-08-12"^^xsd:date .
