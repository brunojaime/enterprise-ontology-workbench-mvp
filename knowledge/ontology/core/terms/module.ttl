@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix eow: <https://knowledge.example.com/ontology/core#> .
@prefix module: <https://knowledge.example.com/id/module/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

eow:module a owl:ObjectProperty ;
    rdfs:domain eow:KnowledgeManifest ;
    rdfs:range eow:OntologyModule ;
    skos:prefLabel "incluye módulo"@es ;
    skos:definition "Relaciona un manifiesto de conocimiento con un módulo que debe cargar."@es ;
    skos:scopeNote "Se lee desde el manifiesto hacia cada módulo cargable."@es ;
    skos:example "manifest:workbench eow:module module:core ." ;
    dcterms:isPartOf module:core ;
    eow:status "active" ;
    dcterms:source "Especificación canónica, Plan 02"@es ;
    dcterms:creator "Codex generator" ;
    dcterms:created "2026-08-12"^^xsd:date .
