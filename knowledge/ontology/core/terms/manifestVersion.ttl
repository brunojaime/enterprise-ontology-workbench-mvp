@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix eow: <https://knowledge.example.com/ontology/core#> .
@prefix module: <https://knowledge.example.com/id/module/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

eow:manifestVersion a owl:DatatypeProperty ;
    rdfs:domain eow:KnowledgeManifest ;
    rdfs:range xsd:string ;
    skos:prefLabel "versión del manifiesto"@es ;
    skos:definition "Versión del contrato RDF que estructura el manifiesto de conocimiento."@es ;
    skos:scopeNote "Se lee desde un manifiesto hacia la versión textual que declara."@es ;
    skos:example "manifest:workbench eow:manifestVersion \"1.0\" ." ;
    dcterms:isPartOf module:core ;
    eow:status "active" ;
    dcterms:source "Especificación canónica, Plan 02"@es ;
    dcterms:creator "Codex generator" ;
    dcterms:created "2026-08-12"^^xsd:date .
