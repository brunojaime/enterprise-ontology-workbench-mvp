@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix eow: <https://knowledge.example.com/ontology/core#> .
@prefix module: <https://knowledge.example.com/id/module/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

eow:graph a owl:ObjectProperty ;
    rdfs:domain eow:OntologyModule ;
    rdfs:range rdf:Resource ;
    skos:prefLabel "grafo responsable"@es ;
    skos:definition "Relaciona un módulo con la IRI estable del named graph donde se cargan sus definiciones."@es ;
    skos:scopeNote "Se lee desde el módulo hacia el named graph que conserva sus triples."@es ;
    skos:example "module:core eow:graph <https://knowledge.example.com/graph/ontology/core> ." ;
    dcterms:isPartOf module:core ;
    eow:status "active" ;
    dcterms:source "Especificación canónica, secciones 11 y 12"@es ;
    dcterms:creator "Codex generator" ;
    dcterms:created "2026-08-12"^^xsd:date .
