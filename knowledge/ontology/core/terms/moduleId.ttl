@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix eow: <https://knowledge.example.com/ontology/core#> .
@prefix module: <https://knowledge.example.com/id/module/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

eow:moduleId a owl:DatatypeProperty ;
    rdfs:domain eow:OntologyModule ;
    rdfs:range xsd:string ;
    skos:prefLabel "identificador de módulo"@es ;
    skos:definition "Identificador estable y legible de un módulo cargable."@es ;
    skos:scopeNote "Se lee desde el módulo hacia su identificador textual."@es ;
    skos:example "module:core eow:moduleId \"core\" ." ;
    dcterms:isPartOf module:core ;
    eow:status "active" ;
    dcterms:source "Especificación canónica, Plan 02"@es ;
    dcterms:creator "Codex generator" ;
    dcterms:created "2026-08-12"^^xsd:date .
