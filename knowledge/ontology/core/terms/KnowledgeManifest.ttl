@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix eow: <https://knowledge.example.com/ontology/core#> .
@prefix module: <https://knowledge.example.com/id/module/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

eow:KnowledgeManifest a owl:Class ;
    skos:prefLabel "Manifiesto de conocimiento"@es ;
    skos:definition "Documento RDF que declara la versión, el namespace y los módulos cargables del repositorio."@es ;
    dcterms:isPartOf module:core ;
    eow:status "active" ;
    dcterms:source "Especificación canónica, Plan 02"@es ;
    dcterms:creator "Codex generator" ;
    dcterms:created "2026-08-12"^^xsd:date .
