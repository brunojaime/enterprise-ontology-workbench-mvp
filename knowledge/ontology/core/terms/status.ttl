@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix eow: <https://knowledge.example.com/ontology/core#> .
@prefix module: <https://knowledge.example.com/id/module/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

eow:status a owl:AnnotationProperty ;
    rdfs:domain rdf:Resource ;
    rdfs:range xsd:string ;
    skos:prefLabel "estado de gobierno"@es ;
    skos:definition "Estado controlado de un recurso: proposed, active o deprecated; para conjuntos se admiten además los estados de procedencia de la especificación."@es ;
    skos:scopeNote "Se lee desde un recurso gobernado hacia su estado textual controlado."@es ;
    skos:example "eow:KnowledgeManifest eow:status \"active\" ." ;
    dcterms:isPartOf module:core ;
    eow:status "active" ;
    dcterms:source "Especificación canónica, secciones 14 y 17"@es ;
    dcterms:creator "Codex generator" ;
    dcterms:created "2026-08-12"^^xsd:date .
