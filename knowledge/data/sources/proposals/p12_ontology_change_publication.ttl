<urn:eow:proposal-statement:75c65835556bb31789d1fbf819bd7b9e44f8d554180da752fe95caf4810f3771> a rdf:Statement ;
    dcterms:source "El Workbench ejecuta el protocolo gobernado descrito por la especificación"@es ;
