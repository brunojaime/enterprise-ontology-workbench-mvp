# Canonical Git checkout mounted into the packaged API.
EOW_REPOSITORY_PATH=/srv/enterprise-ontology-workbench/repository

# Safe default: read-only knowledge and disabled authoring endpoints.
EOW_REPOSITORY_READ_ONLY=true
EOW_WRITE_ENABLED=false

# Internal bind and browser origin. Keep exposure behind the approved network.
EOW_BIND_ADDRESS=127.0.0.1
API_PORT=8000
WEB_PORT=3000
EOW_WEB_ORIGIN=http://localhost:3000

EOW_IMAGE_TAG=local
EOW_LOG_LEVEL=INFO
