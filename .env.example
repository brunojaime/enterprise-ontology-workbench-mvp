# Runtime profile used by the local scaffold.
EOW_ENV=development
EOW_WRITE_ENABLED=false

# Host ports published by compose.yaml.
API_PORT=8000
WEB_PORT=3000

# Browser-visible URL used by the web application to reach the API.
PUBLIC_API_BASE_URL=http://localhost:8000

# Outside Compose, controlled mutations are disabled by default through
# EOW_WRITE_ENABLED=false. compose.yaml overrides that value to true and mounts
# this checkout read/write at /repository so proposal branches can update RDF
# while the runtime reports the real Git branch, commit and dirty state.
